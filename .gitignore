# Unity project .gitignore
# Keep Assets/, Packages/, ProjectSettings/ and every required .meta file in Git.

# -----------------------------------------------------------------------------
# Unity-generated folders
# -----------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Profiler captures and recordings can be large or contain sensitive data.
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Uncomment if Asset Store Tools is installed only for local use.
# /[Aa]ssets/AssetStoreTools*

# Auto-generated JetBrains Rider integration plugin.
/[Aa]ssets/Plugins/Editor/JetBrains*

# -----------------------------------------------------------------------------
# Unity-generated IDE/project files
# -----------------------------------------------------------------------------
/ExportedObj/
/.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity-generated metadata for generated debug/project files only.
*.pidb.meta
*.pdb.meta
*.mdb.meta

# -----------------------------------------------------------------------------
# IDE and editor caches
# -----------------------------------------------------------------------------
/.vs/
/.idea/
/.vscode/
/.fleet/
/.history/
*.sln.iml
*.DotSettings.user

# Gradle cache generated by Android builds.
/.gradle/

# -----------------------------------------------------------------------------
# Build products and generated runtime content
# -----------------------------------------------------------------------------
*.apk
*.aab
*.app
*.ipa
*.unitypackage

# Packed Addressables and temporary Addressables StreamingAssets output.
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/

# -----------------------------------------------------------------------------
# Crash reports and local diagnostics
# -----------------------------------------------------------------------------
sysinfo.txt
crashlytics-build.properties
mono_crash.*.json
*.stackdump

# -----------------------------------------------------------------------------
# Operating-system and editor temporary files
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
*~
*.swp
*.swo
*.orig
*.rej

# -----------------------------------------------------------------------------
# Project-specific local/generated content
# -----------------------------------------------------------------------------
/Assets/GameFramework/
/Assets/GameFramework.meta
/AssetBundleScan/
/ScanOutPut/
/OutputCache/
/TextToolDatas/
/HubOpen.log
/Packages/com.unity.ide.cursor-master/
